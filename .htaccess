# Force browsers (และ Chrome's PWA install-prompt engine) ให้ revalidate ไฟล์พวกนี้ทุกครั้ง
# แทนที่จะแคชไว้ถาวร — ไฟล์เหล่านี้เปลี่ยนเนื้อหาได้ตอนแอดมินอัปโหลดโลโก้ใหม่ใน admin_logo.html
# (app-manifest.json ถูก Chrome อ่านตรงจาก <link rel="manifest"> ก่อนที่ JS ฝั่งหน้าเว็บจะทำงานอีก
# ด้วยซ้ำ จึงต้องกันแคชที่ระดับ HTTP header ไม่ใช่แค่ query-string บน icon เหมือนที่ทำกับ favicon)
<IfModule mod_headers.c>
    <FilesMatch "^(app-manifest|directory-manifest)\.json$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
    <FilesMatch "^favicon\.ico$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
    # หน้าเว็บ (.html) — เดิมไม่มีหัวข้อนี้ เบราว์เซอร์จำหน้าเก่าไว้เอง ปิด-เปิดใหม่ยังเห็นของเก่าจนกด F5
    # no-cache = เช็กกับเซิร์ฟเวอร์ทุกครั้ง (ไม่เปลี่ยนก็ได้ 304 กลับมา ไม่โหลดซ้ำ) · js/css ใช้ ?v= อยู่แล้ว
    <FilesMatch "\.html?$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>

# TISAX: ของที่ไม่ใช่ส่วนของระบบ (ไฟล์สำรอง ฐานข้อมูล log สคริปต์ โค้ดพร้อมประวัติ) ห้ามเปิดผ่านเว็บ
# เคยหลุดอยู่บนเครื่องจริงจริง ๆ (DB dump, .git, backup zip) — กันไว้ทั้งระดับไฟล์และโฟลเดอร์
<IfModule mod_alias.c>
    RedirectMatch 403 ^/PowertechCenter/(\.git|\.claude|\.qodo|\.vscode|\.cursor|DB|database|tools|bin|node_modules|docs|src|orchestration|ตัวอย่างพัฒนา)(/|$)
    RedirectMatch 403 ^/PowertechCenter/([^/]+\.(txt|md|log|bat|ps1|py|sh|lock)|package(-lock)?\.json)$
    RedirectMatch 403 \.(sql|zip|7z|rar|bak|jsonl|env)$
    # ไฟล์ action/helper ถูก api.php include เท่านั้น — เรียกตรงจะข้ามด่านล็อกอินกลาง
    RedirectMatch 403 ^/PowertechCenter/(api/actions|includes)/
    # สคริปต์ติดตั้ง/ใส่ข้อมูลครั้งเดียว และ endpoint เก่าก่อนมี api.php (migrate.php บอกรหัสผ่านตัวเองใน error)
    RedirectMatch 403 ^/PowertechCenter/(migrate|seed_[^/]*|populate_kb|create_hash|add_item|delete_item|update_item|setup_server_check|tmp_query|auto_login_test)\.php$
    RedirectMatch 403 /\.(?!well-known)
</IfModule>
