                };

                const fd = new FormData();
                fd.append('action', 'update_item');
                fd.append('key', 'it_logs');
                fd.append('data', JSON.stringify(updatePayload));
                
                try {
                    const response = await fetch('api.php', { method: 'POST', body: fd });
                    const resData = await response.json();
                    if (!response.ok || resData.status !== 'success') {
                        throw new Error(resData.message || 'Failed to close ticket.');
                    }

                    // Upload files if any
                    if (formValues.files && formValues.files.length > 0) {
                        for(const f of formValues.files) {
                            const fileFd = new FormData();
                            fileFd.append('action', 'upload_attachment');
                            fileFd.append('log_id', id);
                            fileFd.append('attachmentFile', f);
