        // --- 6. Helpers ---
        function populateServicedByDropdown() {
            const it = allEmployees.filter(e => e.assignments?.some(a => a.department === 'IT'));
            gid('form-servicedBy').innerHTML = '<option value="">เลือก</option>' + it.map(e => `<option value="${e.id}">${e.name}</option>`).join('');
        }
        function populateAllRequestersDropdown() {
            const grouped = allEmployees.reduce((acc, e) => {
                // Find primary assignment or fallback to the first one
                const assign = e.assignments?.find(a => a.is_primary == 1) || e.assignments?.[0];
                const co = assign?.company || 'Other';
                if(!acc[co]) acc[co] = []; acc[co].push(e); return acc;
            }, {});
            gid('form-requester-select').innerHTML = '<option value="">-- เลือก --</option>';
            Object.keys(grouped).sort().forEach(co => {
                const grp = document.createElement('optgroup'); grp.label = co;
                grouped[co].sort((a,b)=>a.name.localeCompare(b.name)).forEach(e => {
                    const assign = e.assignments?.find(a => a.is_primary == 1) || e.assignments?.[0];
                    const dept = assign?.department || '-';
                    const opt = document.createElement('option');
                    opt.value = e.name; opt.textContent = `${e.name} (${dept})`;
                    opt.dataset.company = co; opt.dataset.department = dept; opt.dataset.id = e.id;
                    grp.appendChild(opt);
                });
                gid('form-requester-select').appendChild(grp);
            });
        }
        function populateManualDepartmentDropdown() {
            const co = gid('form-company').value;
            const depts = [...new Set(allEmployees.flatMap(e => e.assignments).filter(a=>a.company===co).map(a=>a.department))];
            gid('form-department').innerHTML = '<option value="">-</option>' + 
                depts.map(d=>`<option value="${d}">${d}</option>`).join('') +
                '<option value="Other">อื่นๆ (Other)</option>';
            gid('form-department').disabled = !co;
        }
        function toggleRequesterMode() {
            const isMan = document.querySelector('input[name="requester-mode"]:checked').value === 'manual';
            gid('requester-auto-container').classList.toggle('hidden', isMan);
            gid('requester-manual-container').classList.toggle('hidden', !isMan);
            gid('requester-manual-container').classList.toggle('grid', isMan);
        }
        function searchAssets(term) {
            const res = gid('asset-results');
            if(term.length<2) { res.classList.add('hidden'); return; }
            const matches = allAssets.filter(a => a['ID อุปกรณ์'].toLowerCase().includes(term.toLowerCase()) || a['ชื่ออุปกรณ์'].toLowerCase().includes(term.toLowerCase())).slice(0,10);
            res.innerHTML = matches.map(a => `<div class="p-2 hover:bg-slate-100 cursor-pointer" onclick="gid('form-asset').value='${a['ID อุปกรณ์']}'; gid('asset-results').classList.add('hidden');">${a['ID อุปกรณ์']} (${a['ชื่ออุปกรณ์']})</div>`).join('');
            res.classList.remove('hidden');
        }
        async function displayAttachments(logId) {
            const list = gid('attachment-list');
            try {
                const res = await (await fetch(`api.php?action=get&file=it_log_attachments&log_id=${logId}&v=${Date.now()}`)).json();
                const files = res.filter(f => f.log_id == logId);
                list.innerHTML = files.map(f => `<a href="uploads/attachments/${f.stored_filename}" target="_blank" class="text-blue-500 hover:underline block truncate"><i class="fas fa-file mr-1"></i>${f.original_filename}</a>`).join('');
            } catch(e) { list.innerHTML = 'Error loading files'; }
        }

        async function showAssetRepairHistory(assetId) {
            try {
                const res = await fetch(`api.php?action=get_asset_repair_history&asset_id=${encodeURIComponent(assetId)}`);
                const history = await res.json();

                if (!Array.isArray(history) || history.length === 0) {
                    Swal.fire({ icon: 'info', title: 'ไม่พบประวัติ', text: `ไม่พบประวัติการซ่อมสำหรับ: ${assetId}` });
                    return;
                }

                const getStatusClass = s => {
                    const map = { 'Pending':'bg-blue-100 text-blue-600', 'In Progress':'bg-amber-100 text-amber-600', 'Waiting for Parts':'bg-red-100 text-red-600', 'Completed':'bg-emerald-100 text-emerald-600', 'Cancelled': 'bg-slate-100 text-slate-500' };
                    return map[s] || 'bg-slate-100 text-slate-500';
                };

                const html = `
                    <div class="text-left space-y-3 max-h-[60vh] overflow-y-auto custom-scrollbar p-1">
                        ${history.map(item => `
                            <div class="p-3 rounded-lg bg-slate-50 dark:bg-slate-700/50 border border-slate-200 dark:border-slate-600 text-sm">
                                <div class="flex justify-between items-start mb-1">
                                    <span class="font-mono font-bold text-blue-600 dark:text-blue-400 text-xs">#${item.id}</span>
                                    <span class="text-[10px] font-bold px-2 py-0.5 rounded-full ${getStatusClass(item.status)}">${item.status}</span>
                                </div>
                                <p class="text-slate-700 dark:text-slate-200 mb-1"><span class="font-semibold">อาการ:</span> ${item.problem}</p>
                                ${item.solution ? `<p class="text-emerald-600 dark:text-emerald-400 text-xs bg-emerald-50 dark:bg-emerald-900/20 p-2 rounded mt-1"><i class="fas fa-check-circle mr-1"></i>${item.solution}</p>` : ''}
                                <div class="text-[10px] text-slate-400 mt-2 flex justify-between">
                                    <span><i class="far fa-calendar mr-1"></i>${new Date(item.date).toLocaleDateString('th-TH')}</span>
                                    <span><i class="fas fa-user-cog mr-1"></i>${item.servicedBy || '-'}</span>
                                </div>
                            </div>
                        `).join('')}
                    </div>`;

                Swal.fire({
                    title: `ประวัติการซ่อม: ${assetId}`,
                    html: html,
                    width: '600px',
                    showCloseButton: true,
                    showConfirmButton: false,
                    customClass: { popup: 'dark:bg-slate-800 dark:border dark:border-slate-700' }
                });

            } catch (e) {
                console.error(e);
                Swal.fire('Error', 'ไม่สามารถโหลดข้อมูลได้', 'error');
            }
        }

        function closeModal() { gid('log-modal').classList.add('hidden'); }

        function setupPrinting() {
            gid('print-report-btn').addEventListener('click', () => {
                // Inject Landscape Style for List (บังคับแนวนอนสำหรับรายงานรวม)
                const existingStyle = document.getElementById('print-orientation');
                if (existingStyle) existingStyle.remove();

                const style = document.createElement('style');
                style.id = 'print-orientation';
                style.innerHTML = `
                    @page { size: A4 landscape; margin: 1cm; }
                    .print-table { width: 100%; border-collapse: collapse; font-family: 'Sarabun', 'Kanit', sans-serif; font-size: 10pt; }
                    .print-table th, .print-table td { border: 1px solid #000; padding: 6px 8px; text-align: left; vertical-align: top; }
                    .print-table th { background-color: #f3f4f6; color: #000; font-weight: bold; text-transform: uppercase; font-size: 9pt; text-align: center; }
                    .print-table tr { page-break-inside: avoid; }
                    .status-badge-print { padding: 2px 6px; border: 1px solid #999; border-radius: 4px; font-size: 8pt; font-weight: bold; display: inline-block; text-align: center; min-width: 80px; }
                `;
                document.head.appendChild(style);

                const pc = document.querySelector('.print-container');
                
                // Get currently displayed rows to respect filters
                const displayedRows = Array.from(document.querySelectorAll('#table-body tr'));
                
                if (displayedRows.length === 0) {
                    Swal.fire('แจ้งเตือน', 'ไม่มีข้อมูลในตารางให้พิมพ์', 'warning');
                    return;
                }

                const printRows = displayedRows.map(row => {
                    const logId = row.id.replace('row-', '');
                    const log = allLogs.find(l => l.id === logId);
                    if (!log) return '';

                    return `
                        <tr>
                            <td style="text-align: center;">
                                <div style="font-weight: bold;">${log.id}</div>
                                <div style="font-size: 9pt; color: #555;">${new Date(log.date).toLocaleDateString('th-TH')}</div>
                            </td>
                            <td>
                                <div style="font-weight: bold;">${log.requester || '-'}</div>
                                <div style="font-size: 9pt;">${log.department || '-'}</div>
                                ${log.asset ? `<div style="font-size: 9pt; margin-top: 2px; color: #444;">Asset: ${log.asset}</div>` : ''}
                            </td>
                            <td>
                                <div style="margin-bottom: 4px;">${log.problem || '-'}</div>
                                ${log.solution ? `<div style="margin-top: 4px; font-size: 9pt; color: #065f46; border-top: 1px dashed #ccc; padding-top: 2px;"><strong>แก้ไข:</strong> ${log.solution}</div>` : ''}
                                <div style="margin-top: 2px; font-size: 8pt; color: #666;">ความเร่งด่วน: ${log.urgency}</div>
                            </td>
                            <td>${log.servicedBy || '-'}</td>
                            <td style="text-align: center;">
                                <span class="status-badge-print">${log.status}</span>
                            </td>
                        </tr>
                    `;
                }).join('');

                pc.innerHTML = `
                    <div style="text-align: center; margin-bottom: 15px;">
                        <h2 style="font-size: 18pt; font-weight: bold; margin: 0;">รายงานแจ้งซ่อม IT</h2>
                        <p style="font-size: 10pt; color: #666; margin: 5px 0 0 0;">พิมพ์เมื่อ: ${new Date().toLocaleString('th-TH')}</p>
                    </div>
                    <table class="print-table">
                        <thead>
                            <tr>
                                <th style="width: 12%">Case ID / Date</th>
                                <th style="width: 20%">Requester / Asset</th>
                                <th style="width: 40%">Problem / Solution</th>
                                <th style="width: 15%">Serviced By</th>
                                <th style="width: 13%">Status</th>
                            </tr>
                        </thead>
                        <tbody>${printRows}</tbody>
                    </table>
                    <div style="margin-top: 10px; text-align: right; font-size: 9pt; color: #888;">
                        จำนวนรายการทั้งหมด: ${displayedRows.length}
                    </div>
                `;
                
                setTimeout(() => {
                    window.print();
                }, 100);
            });
        }

        function exportLogs() {
            const co = gid('company-filter').value;
            const stat = gid('status-filter').value;
            const typ = gid('type-filter').value;
            const search = gid('search-input').value;
            
            const query = new URLSearchParams({ action: 'export_logs', company: co, status: stat, type: typ, search: search });
            window.location.href = `api.php?${query.toString()}`;
        }

        // --- Init ---
        document.addEventListener('DOMContentLoaded', async () => {
            initializeThemeToggle();
            const sess = await (await fetch('api.php?action=check_session')).json();
            if(!sess.loggedin) window.location.href = 'login.html';
            userRole = sess.role;
            currentUserName = sess.display_name;
            currentUserId = sess.user_id;
            sessionStorage.setItem('user_id', sess.user_id);

            await loadInitialData();
            
            // ตรวจสอบ URL Parameter เพื่อเปิด Ticket อัตโนมัติ (เช่น จากการสแกน QR Code)
            const urlParams = new URLSearchParams(window.location.search);
            const ticketIdParam = urlParams.get('ticket_id');
            if (ticketIdParam) {
                const logExists = allLogs.some(l => l && l.id === ticketIdParam);
                if (logExists) {
                    // ใช้ showFullDetails เพื่อแสดงข้อมูลสรุป ไม่ใช่หน้าแก้ไข
                    showFullDetails(ticketIdParam);
                }
            }

            // Listeners
            gid('add-ticket-btn').addEventListener('click', () => openLogModal());
            gid('export-btn').addEventListener('click', exportLogs);
            gid('log-form').addEventListener('submit', handleLogSubmit);
            gid('form-company').addEventListener('change', populateManualDepartmentDropdown);
            document.querySelectorAll('input[name="requester-mode"]').forEach(r => r.addEventListener('change', toggleRequesterMode));
            gid('form-asset').addEventListener('input', e => searchAssets(e.target.value));
            document.addEventListener('click', e => { if(!e.target.closest('.asset-search-wrapper')) gid('asset-results').classList.add('hidden'); });
            
            ['search-input','company-filter','status-filter','type-filter'].forEach(id => gid(id).addEventListener('input', renderTable));
            document.querySelectorAll('.stat-pill').forEach(p => p.addEventListener('click', () => {
                document.querySelectorAll('.stat-pill').forEach(x => x.classList.remove('active'));
                p.classList.add('active');
                gid('status-filter').value = p.dataset.filterValue;
                renderTable();
            }));
            setupPrinting();
        });
    </script>
</body>
</html>