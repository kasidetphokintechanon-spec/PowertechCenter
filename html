<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>IT Service Log - Command Center</title>
    
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/simplelightbox/2.14.2/simple-lightbox.min.css" />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/simplelightbox/2.14.2/simple-lightbox.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>

    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                fontFamily: { sans: ['Kanit', 'sans-serif'] },
                extend: {
                    colors: {
                        primary: '#2563eb', // Blue-600
                        secondary: '#475569', // Slate-600
                        success: '#10b981', // Emerald-500
                        warning: '#f59e0b', // Amber-500
                        danger: '#ef4444', // Red-500
                        info: '#6366f1', // Indigo-500
                    }
                }
            }
        };
        // Theme Loader
        (function() {
            const theme = localStorage.getItem('theme') || 'light';
            if (theme === 'dark') document.documentElement.classList.add('dark');
        })();
    </script>

    <style>
        /* Custom Scrollbar */
        .custom-scrollbar::-webkit-scrollbar { height: 8px; width: 8px; }
        .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
        .custom-scrollbar::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 4px; }
        .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: #94a3b8; }
        .dark .custom-scrollbar::-webkit-scrollbar-thumb { background: #475569; }

        /* Print Styles */
        @media print {
            @page { size: auto; margin: 1cm; }
            body { background: white; -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important; }
            .no-print, header, .stats-bar, #filter-bar, .action-cell, button, #add-ticket-btn, #theme-toggle { display: none !important; }
            .main-container { padding: 0; max-width: none; }
            .card { box-shadow: none; border: none; padding: 0; }
            table { width: 100%; border-collapse: collapse; font-size: 10pt; }
            th, td { border: 1px solid #ddd; padding: 8px; text-align: left; }
            th { background-color: #f3f4f6; color: #000; }
            
            /* Print Single Ticket Mode */
            body.printing-ticket > *:not(.print-container) { display: none !important; }
            body.printing-ticket .print-container { display: block !important; width: 100%; height: 100%; }
        }
        
        /* Stats Pill Active State */
        .stat-pill.active { 
            background-color: white; 
            border-color: #3b82f6; 
            box-shadow: 0 4px 6px -1px rgba(59, 130, 246, 0.1), 0 2px 4px -1px rgba(59, 130, 246, 0.06);
        }
        .dark .stat-pill.active {
            background-color: #1e293b;
            border-color: #60a5fa;
        }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 dark:bg-slate-900 dark:text-slate-100 flex flex-col h-screen overflow-hidden transition-colors duration-300">

    <header class="bg-white/90 dark:bg-slate-800/90 backdrop-blur-sm h-16 border-b border-slate-200 dark:border-slate-700 flex justify-between items-center px-6 shadow-sm z-20 no-print flex-shrink-0">
        <div class="flex items-center gap-4">
            <a href="index.html" class="w-10 h-10 flex items-center justify-center rounded-lg bg-slate-100 dark:bg-slate-700 text-slate-500 hover:text-blue-600 hover:bg-blue-50 transition-colors">
                <i class="fas fa-arrow-left"></i>
            </a>
            <div>
                <h1 class="text-xl font-bold bg-clip-text text-transparent bg-gradient-to-r from-blue-600 to-indigo-600">IT Command Center</h1>
                <p class="text-xs text-slate-500 dark:text-slate-400 hidden sm:block">ระบบบันทึกและติดตามงานแจ้งซ่อม</p>
            </div>
        </div>
        <div class="flex items-center gap-3">
            <button id="chart-btn" onclick="toggleChart()" class="hidden sm:flex items-center gap-2 px-4 py-2 text-sm font-medium text-indigo-600 bg-white border border-indigo-200 rounded-lg hover:bg-indigo-50 hover:text-indigo-700 transition shadow-sm dark:bg-slate-700 dark:border-slate-600 dark:text-indigo-400 dark:hover:bg-slate-600">
                <i class="fas fa-chart-pie"></i> กราฟ
            </button>
            <button id="print-report-btn" class="hidden sm:flex items-center gap-2 px-4 py-2 text-sm font-medium text-slate-600 bg-white border border-slate-300 rounded-lg hover:bg-slate-50 hover:text-slate-800 transition shadow-sm dark:bg-slate-700 dark:border-slate-600 dark:text-slate-200 dark:hover:bg-slate-600">
                <i class="fas fa-print"></i> พิมพ์รายงาน
            </button>
            <button id="export-btn" class="hidden sm:flex items-center gap-2 px-4 py-2 text-sm font-medium text-emerald-600 bg-white border border-emerald-200 rounded-lg hover:bg-emerald-50 hover:text-emerald-700 transition shadow-sm dark:bg-slate-700 dark:border-slate-600 dark:text-emerald-400 dark:hover:bg-slate-600">
                <i class="fas fa-file-excel"></i> Export
            </button>
            <button id="add-ticket-btn" class="flex items-center gap-2 px-4 py-2 text-sm font-medium text-white bg-blue-600 rounded-lg hover:bg-blue-700 transition shadow-md shadow-blue-500/20">
                <i class="fas fa-plus"></i> <span class="hidden sm:inline">เพิ่มรายการ</span>
            </button>
            <div class="h-6 w-px bg-slate-200 dark:bg-slate-700 mx-1"></div>
            <button id="theme-toggle" class="w-10 h-10 rounded-lg flex items-center justify-center text-slate-500 hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors">
                <i class="fas fa-sun block dark:hidden"></i>
                <i class="fas fa-moon hidden dark:block"></i>
            </button>
        </div>
    </header>

    <main class="flex-1 overflow-y-auto p-4 sm:p-6 custom-scrollbar">
        <div class="max-w-7xl mx-auto space-y-6">

            <div id="chart-section" class="hidden bg-white dark:bg-slate-800 p-6 rounded-xl border border-slate-200 dark:border-slate-700 shadow-sm relative animate-fade-in">
                <h3 class="font-bold text-slate-700 dark:text-slate-200 mb-4 flex items-center gap-2"><i class="fas fa-chart-pie text-indigo-500"></i> สัดส่วนงานซ่อมตามสถานะ</h3>
                <div class="h-64 w-full flex justify-center">
                    <canvas id="statusPieChart"></canvas>
                </div>
            </div>

            <div class="stats-bar grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-3 no-print">
                <div class="stat-pill active cursor-pointer bg-white dark:bg-slate-800 p-3 rounded-xl border border-slate-200 dark:border-slate-700 shadow-sm hover:shadow-md transition-all group" data-filter-value="">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-2 text-slate-500 group-hover:text-blue-500 dark:text-slate-400">
                            <i class="fas fa-clipboard-list"></i> <span class="text-sm font-medium">ทั้งหมด</span>
                        </div>
                        <span id="totalTickets" class="bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-300 text-xs font-bold px-2 py-1 rounded-full">0</span>
                    </div>
                </div>
                <div class="stat-pill cursor-pointer bg-white dark:bg-slate-800 p-3 rounded-xl border border-slate-200 dark:border-slate-700 shadow-sm hover:shadow-md transition-all group" data-filter-value="Pending">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-2 text-slate-500 group-hover:text-blue-500 dark:text-slate-400">
                            <i class="fas fa-hourglass-half"></i> <span class="text-sm font-medium">รอรับเรื่อง</span>
                        </div>
                        <span id="pendingTickets" class="bg-blue-100 text-blue-600 dark:bg-blue-900/30 dark:text-blue-400 text-xs font-bold px-2 py-1 rounded-full">0</span>
                    </div>
                </div>
                <div class="stat-pill cursor-pointer bg-white dark:bg-slate-800 p-3 rounded-xl border border-slate-200 dark:border-slate-700 shadow-sm hover:shadow-md transition-all group" data-filter-value="In Progress">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-2 text-slate-500 group-hover:text-amber-500 dark:text-slate-400">
                            <i class="fas fa-person-digging"></i> <span class="text-sm font-medium">กำลังทำ</span>
                        </div>
                        <span id="progressTickets" class="bg-amber-100 text-amber-600 dark:bg-amber-900/30 dark:text-amber-400 text-xs font-bold px-2 py-1 rounded-full">0</span>
                    </div>
                </div>
                <div class="stat-pill cursor-pointer bg-white dark:bg-slate-800 p-3 rounded-xl border border-slate-200 dark:border-slate-700 shadow-sm hover:shadow-md transition-all group" data-filter-value="Waiting for Parts">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-2 text-slate-500 group-hover:text-red-500 dark:text-slate-400">
                            <i class="fas fa-box-open"></i> <span class="text-sm font-medium">รออะไหล่</span>
                        </div>
                        <span id="waitingTickets" class="bg-red-100 text-red-600 dark:bg-red-900/30 dark:text-red-400 text-xs font-bold px-2 py-1 rounded-full">0</span>
                    </div>
                </div>
                <div class="stat-pill cursor-pointer bg-white dark:bg-slate-800 p-3 rounded-xl border border-slate-200 dark:border-slate-700 shadow-sm hover:shadow-md transition-all group" data-filter-value="Temporary Fix">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-2 text-slate-500 group-hover:text-indigo-500 dark:text-slate-400">
                            <i class="fas fa-screwdriver-wrench"></i> <span class="text-sm font-medium">แก้ชั่วคราว</span>
                        </div>
                        <span id="tempFixTickets" class="bg-indigo-100 text-indigo-600 dark:bg-indigo-900/30 dark:text-indigo-400 text-xs font-bold px-2 py-1 rounded-full">0</span>
                    </div>
                </div>
                <div class="stat-pill cursor-pointer bg-white dark:bg-slate-800 p-3 rounded-xl border border-slate-200 dark:border-slate-700 shadow-sm hover:shadow-md transition-all group" data-filter-value="Completed">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-2 text-slate-500 group-hover:text-emerald-500 dark:text-slate-400">
                            <i class="fas fa-check-circle"></i> <span class="text-sm font-medium">เสร็จสิ้น</span>
                        </div>
                        <span id="completedTickets" class="bg-emerald-100 text-emerald-600 dark:bg-emerald-900/30 dark:text-emerald-400 text-xs font-bold px-2 py-1 rounded-full">0</span>
                    </div>
                </div>
            </div>

            <div id="filter-bar" class="flex flex-col sm:flex-row gap-4 items-center justify-between bg-white dark:bg-slate-800 p-4 rounded-xl border border-slate-200 dark:border-slate-700 shadow-sm no-print">
                <div class="flex gap-2 w-full sm:w-auto overflow-x-auto pb-2 sm:pb-0">
                    <select id="company-filter" class="form-select bg-slate-50 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-lg text-sm p-2 focus:ring-2 focus:ring-blue-500 dark:text-white">
                        <option value="">ทุกบริษัท</option>
                        <option value="PTA">PTA</option>
                        <option value="PT4">PT4</option>
                        <option value="PTE">PTE</option>
                    </select>
                    <select id="type-filter" class="form-select bg-slate-50 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-lg text-sm p-2 focus:ring-2 focus:ring-blue-500 dark:text-white">
                        <option value="">ทุกประเภท</option>
                        <option value="Hardware">Hardware</option>
                        <option value="Software">Software</option>
                        <option value="Network">Network</option>
                        <option value="Other">Other</option>
                    </select>
                    <select id="status-filter" class="hidden">
                        <option value="">All</option>
                        <option value="Pending">Pending</option>
                        <option value="In Progress">In Progress</option>
                        <option value="Waiting for Parts">Waiting for Parts</option>
                        <option value="Temporary Fix">Temporary Fix</option>
                        <option value="Completed">Completed</option>
                    </select> </div>
                <div class="relative w-full sm:w-64">
                    <i class="fas fa-search absolute left-3 top-1/2 transform -translate-y-1/2 text-slate-400"></i>
                    <input type="text" id="search-input" placeholder="ค้นหา Case ID, ชื่อ, ปัญหา..." class="w-full pl-10 pr-4 py-2 bg-slate-50 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 dark:text-white">
                </div>
            </div>

            <div class="bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 shadow-sm overflow-hidden">
                <div class="overflow-x-auto custom-scrollbar">
                    <table class="w-full text-left text-sm text-slate-600 dark:text-slate-300 table">
                        <thead class="bg-slate-50 dark:bg-slate-700/50 text-slate-500 dark:text-slate-400 uppercase font-semibold text-xs sticky top-0 z-10">
                            <tr>
                                <th class="px-6 py-4 w-12 text-center no-print"><i class="fas fa-paperclip"></i></th>
                                <th class="px-6 py-4">Case ID</th>
                                <th class="px-6 py-4">ผู้แจ้ง / Asset</th>
                                <th class="px-6 py-4 w-1/3">ปัญหา / การแก้ไข</th>
                                <th class="px-6 py-4">ผู้รับผิดชอบ</th>
                                <th class="px-6 py-4">สถานะ</th>
                                <th class="px-6 py-4">วันที่ปิด / ระยะเวลา</th>
                                <th class="px-6 py-4 text-right no-print">จัดการ</th>
                            </tr>
                        </thead>
                        <tbody id="table-body" class="divide-y divide-slate-100 dark:divide-slate-700/50">
                            </tbody>
                    </table>
                </div>
                <div id="no-results" class="hidden flex-col items-center justify-center py-12 text-slate-400">
                    <div class="w-16 h-16 bg-slate-100 dark:bg-slate-700/50 rounded-full flex items-center justify-center mb-4">
                        <i class="fas fa-search text-2xl opacity-50"></i>
                    </div>
                    <p>ไม่พบรายการที่ค้นหา</p>
                </div>
            </div>

        </div>
    </main>

    <div id="log-modal" class="fixed inset-0 z-50 hidden no-print" aria-labelledby="modal-title" role="dialog" aria-modal="true">
        <div class="absolute inset-0 bg-slate-900/60 backdrop-blur-sm transition-opacity" onclick="closeModal()"></div>
        <div class="flex min-h-full items-end justify-center p-4 text-center sm:items-center sm:p-0">
            <div class="relative transform overflow-hidden rounded-xl bg-white dark:bg-slate-800 text-left shadow-xl transition-all sm:my-8 w-full max-w-4xl flex flex-col max-h-[90vh]">
                <div class="flex justify-between items-center px-6 py-4 border-b border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800/50">
                    <h3 class="text-lg font-bold text-slate-800 dark:text-white" id="modal-title">บันทึกงาน</h3>
                    <button onclick="closeModal()" class="text-slate-400 hover:text-slate-600 dark:hover:text-white transition"><i class="fas fa-times text-xl"></i></button>
                </div>
                
                <form id="log-form" class="flex flex-col flex-grow overflow-hidden">
                    <div class="modal-body-scrollable p-6 overflow-y-auto space-y-6">
                        
                        <div class="bg-slate-50 dark:bg-slate-700/30 p-4 rounded-lg border border-slate-100 dark:border-slate-700">
                            <div class="flex gap-6 mb-4">
                                <label class="flex items-center gap-2 cursor-pointer">
                                    <input type="radio" name="requester-mode" value="auto" checked class="text-blue-600 focus:ring-blue-500">
                                    <span class="text-sm font-medium dark:text-slate-200">แจ้งโดยพนักงาน</span>
                                </label>
                                <label class="flex items-center gap-2 cursor-pointer">
                                    <input type="radio" name="requester-mode" value="manual" class="text-blue-600 focus:ring-blue-500">
                                    <span class="text-sm font-medium dark:text-slate-200">แจ้งสำหรับแผนก/อื่นๆ</span>
                                </label>
                            </div>
                            
                            <div id="requester-auto-container">
                                <label class="block text-xs font-medium text-slate-500 dark:text-slate-400 mb-1">ผู้แจ้ง</label>
                                <select class="w-full p-2.5 rounded-lg border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-sm dark:text-white" id="form-requester-select" required>
                                    <option value="">-- กรุณาเลือกผู้แจ้ง --</option>
                                </select>
                            </div>

                            <div id="requester-manual-container" class="hidden grid-cols-1 md:grid-cols-3 gap-4">
                                <div><label class="block text-xs font-medium text-slate-500 dark:text-slate-400 mb-1">บริษัท</label><select id="form-company" class="w-full p-2.5 rounded-lg border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-sm dark:text-white"><option value="">เลือก</option><option value="PTA">PTA</option><option value="PT4">PT4</option><option value="PTE">PTE</option></select></div>
                                <div><label class="block text-xs font-medium text-slate-500 dark:text-slate-400 mb-1">แผนก</label><select id="form-department" class="w-full p-2.5 rounded-lg border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-sm dark:text-white" disabled><option value="">-</option></select></div>
                                <div><label class="block text-xs font-medium text-slate-500 dark:text-slate-400 mb-1">ชื่องาน (Optional)</label><input type="text" id="form-job-name-manual" class="w-full p-2.5 rounded-lg border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-sm dark:text-white" placeholder="เช่น ตรวจสอบ Server"></div>
                            </div>
                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                            <div>
                                <label class="block text-xs font-medium text-slate-500 dark:text-slate-400 mb-1">ผู้รับผิดชอบ</label>
                                <select id="form-servicedBy" class="w-full p-2.5 rounded-lg border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-sm dark:text-white"><option value="">เลือก</option></select>
                            </div>
                            <div>
                                <label class="block text-xs font-medium text-slate-500 dark:text-slate-400 mb-1">Asset No.</label>
                                <div class="asset-search-wrapper relative">
                                    <input type="text" id="form-asset" placeholder="ค้นหารหัสพัสดุ..." class="w-full p-2.5 rounded-lg border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-sm dark:text-white">
                                    <div id="asset-results" class="hidden absolute z-10 w-full mt-1 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-600 rounded-lg shadow-lg max-h-48 overflow-y-auto"></div>
                                </div>
                            </div>
                        </div>

                        <div>
                            <label class="block text-xs font-medium text-slate-500 dark:text-slate-400 mb-1">ปัญหา / อาการ</label>
                            <textarea id="form-problem" rows="3" class="w-full p-2.5 rounded-lg border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-sm dark:text-white" required></textarea>
                        </div>
                        <div>
                            <label class="block text-xs font-medium text-slate-500 dark:text-slate-400 mb-1">วิธีแก้ไข</label>
                            <textarea id="form-solution" rows="3" class="w-full p-2.5 rounded-lg border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-sm dark:text-white"></textarea>
                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
                            <div><label class="block text-xs font-medium text-slate-500 dark:text-slate-400 mb-1">ประเภท</label><select id="form-type" class="w-full p-2.5 rounded-lg border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-sm dark:text-white" required><option value="">เลือก</option><option value="Hardware">Hardware</option><option value="Software">Software</option><option value="Network">Network</option><option value="Other">Other</option></select></div>
                            <div><label class="block text-xs font-medium text-slate-500 dark:text-slate-400 mb-1">สถานะ</label><select id="form-status" class="w-full p-2.5 rounded-lg border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-sm dark:text-white" required><option value="Pending">Pending</option><option value="In Progress">In Progress</option><option value="Waiting for Parts">Waiting for Parts</option><option value="Temporary Fix">Temporary Fix</option><option value="Completed">Completed</option></select></div>
                            <div><label class="block text-xs font-medium text-slate-500 dark:text-slate-400 mb-1">ความเร่งด่วน</label><select id="form-urgency" class="w-full p-2.5 rounded-lg border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-sm dark:text-white" required><option value="ปกติ">ปกติ</option><option value="ด่วน">ด่วน</option><option value="ด่วนที่สุด">ด่วนที่สุด</option></select></div>
                            <div><label class="block text-xs font-medium text-slate-500 dark:text-slate-400 mb-1">วันที่แจ้ง</label><input type="date" id="form-date" class="w-full p-2.5 rounded-lg border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-sm dark:text-white" required></div>
                            <div class="md:col-span-4"><label class="block text-xs font-medium text-slate-500 dark:text-slate-400 mb-1">วันที่นัดหมาย (Appointment)</label><input type="datetime-local" id="form-appointment_date" class="w-full p-2.5 rounded-lg border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-sm dark:text-white"></div>
                        </div>

                        <div id="repair-cost-wrapper" class="hidden">
                            <label class="block text-xs font-medium text-slate-500 dark:text-slate-400 mb-1">ค่าใช้จ่าย (บาท)</label>
                            <input type="number" step="0.01" id="form-repair_cost" class="w-full p-2.5 rounded-lg border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-sm dark:text-white" placeholder="0.00">
                        </div>

                        <div>
                            <label class="block text-xs font-medium text-slate-500 dark:text-slate-400 mb-1">ไฟล์แนบ</label>
                            <input type="file" id="form-attachments" multiple class="w-full text-sm text-slate-500 dark:text-slate-400 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100 dark:file:bg-slate-700 dark:file:text-slate-200">
                            <div id="attachment-list" class="mt-2 grid grid-cols-2 gap-2 text-xs"></div>
                        </div>

                    </div>
                    <div class="px-6 py-4 border-t border-slate-100 dark:border-slate-700 flex justify-end gap-3 bg-white dark:bg-slate-800">
                        <button type="button" class="px-4 py-2 text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700 rounded-lg text-sm font-medium transition" onclick="closeModal()">ยกเลิก</button>
                        <button type="submit" class="px-6 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg text-sm font-medium shadow-md transition">บันทึกข้อมูล</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="print-container"></div>

    <script>
        // --- 1. Init & Global Variables ---
        let allLogs = [], allEmployees = [], allAssets = [], lightbox;
        let currentEditId = null, userRole = 'user';
        let statusChartInstance = null;
        let selectedLogId = null;
        let currentUserName = '', currentUserId = '';
        const gid = id => document.getElementById(id);

        function applyTheme(theme) { 
            if (theme === 'dark') document.documentElement.classList.add('dark');
            else document.documentElement.classList.remove('dark');
        }
        
        function initializeThemeToggle() {
            const savedTheme = localStorage.getItem('theme') || 'light'; applyTheme(savedTheme);
            const toggle = document.getElementById('theme-toggle');
            if(toggle) toggle.addEventListener('click', () => {
                const isDark = document.documentElement.classList.toggle('dark');
                localStorage.setItem('theme', isDark ? 'dark' : 'light');
            });
        }

        const getStatusClass = s => {
            const map = { 'Pending':'bg-blue-50 text-blue-600 dark:bg-blue-900/30 dark:text-blue-400', 'In Progress':'bg-amber-50 text-amber-600 dark:bg-amber-900/30 dark:text-amber-400', 'Waiting for Parts':'bg-red-50 text-red-600 dark:bg-red-900/30 dark:text-red-400', 'Temporary Fix':'bg-indigo-50 text-indigo-600 dark:bg-indigo-900/30 dark:text-indigo-400', 'Completed':'bg-emerald-50 text-emerald-600 dark:bg-emerald-900/30 dark:text-emerald-400', 'Cancelled': 'bg-slate-100 text-slate-500 dark:bg-slate-700 dark:text-slate-400' };
            return map[s] || 'bg-slate-50 text-slate-600';
        };
        const getStatusIcon = s => {
            const map = { 'Pending':'fa-hourglass-half', 'In Progress':'fa-person-digging', 'Waiting for Parts':'fa-box-open', 'Temporary Fix':'fa-screwdriver-wrench', 'Completed':'fa-check-circle', 'Cancelled': 'fa-ban' };
            return `<i class="fas ${map[s]||'fa-circle'} mr-1.5"></i>`;
        };

        function formatDuration(startDate, endDate) {
            if (!startDate || !endDate) return '-';

            let diff = new Date(endDate) - new Date(startDate);
            if (diff < 0) return '-';

            let days = Math.floor(diff / (1000 * 60 * 60 * 24));
            diff -= days * (1000 * 60 * 60 * 24);

            let hours = Math.floor(diff / (1000 * 60 * 60));
            diff -= hours * (1000 * 60 * 60);

            let mins = Math.floor(diff / (1000 * 60));

            let parts = [];
            if (days > 0) parts.push(`${days} วัน`);
            if (hours > 0) parts.push(`${hours} ชม.`);
            if (mins > 0 && days === 0) parts.push(`${mins} นาที`);

            if (parts.length === 0 && diff > 0) return '< 1 นาที';
            if (parts.length === 0) return '-';
            return parts.join(' ');
        }

        function formatSecondsToDuration(totalSeconds) {
            if (!totalSeconds || totalSeconds <= 0) return '-';

            const days = Math.floor(totalSeconds / 86400);
            totalSeconds %= 86400;
            const hours = Math.floor(totalSeconds / 3600);
            totalSeconds %= 3600;
            const minutes = Math.floor(totalSeconds / 60);

            let parts = [];
            if (days > 0) parts.push(`${days}d`);
            if (hours > 0) parts.push(`${hours}h`);
            if (minutes > 0) parts.push(`${minutes}m`);

            if (parts.length === 0 && totalSeconds > 0) return '< 1m';
            return parts.length > 0 ? parts.join(' ') : '-';
        }

        // --- 2. Data Loading & API ---
        async function loadInitialData() {
            try {
                const [empRes, logRes, astRes] = await Promise.all([
                    fetch(`api.php?action=get&file=employees&v=${Date.now()}`),
                    fetch(`api.php?action=get&file=it_logs&v=${Date.now()}`),
                    fetch(`api.php?action=getEquipmentData&v=${Date.now()}`)
                ]);
                
                if (!empRes.ok || !logRes.ok || !astRes.ok) throw new Error("API Error");
                
                const empData = await empRes.json();
                allEmployees = Array.isArray(empData) ? empData : [];

                // FIX: Parse assignments string into an array for each employee
                allEmployees.forEach(emp => {
                    if (typeof emp.assignments === 'string' && emp.assignments) {
                        try {
                            emp.assignments = JSON.parse(emp.assignments);
                        } catch (e) {
                            emp.assignments = []; // Handle invalid JSON
                        }
                    } else if (!Array.isArray(emp.assignments)) {
                        emp.assignments = []; // Handle null or non-array values
                    }
                });

                const logData = await logRes.json();
                allLogs = Array.isArray(logData) ? logData : [];

                const astData = await astRes.json();
                allAssets = Array.isArray(astData) ? astData : [];

                populateServicedByDropdown();
                renderTable();
                updateStatistics();
            } catch (e) {
                console.error(e);
                gid('table-body').innerHTML = `<tr><td colspan="7" class="text-center py-8 text-red-500">Failed to load data.</td></tr>`;
            }
        }

        // --- 3. Render Table ---
        function renderTable() {
            const tbody = gid('table-body');
            const term = gid('search-input').value.toLowerCase();
            const co = gid('company-filter').value, stat = gid('status-filter').value, typ = gid('type-filter').value;

            const filtered = allLogs.filter(l => {
                if(!l) return false;
                const txt = Object.values(l).join(' ').toLowerCase();
                return (!term || txt.includes(term)) && (!co || l.company===co) && (!stat || l.status===stat) && (!typ || l.type===typ);
            });

            gid('no-results').classList.toggle('flex', filtered.length===0);
            gid('no-results').classList.toggle('hidden', filtered.length>0);

            tbody.innerHTML = filtered.map(log => {
                const isImg = log.first_attachment && /\.(jpg|jpeg|png|webp)$/i.test(log.first_attachment);
                const attach = log.first_attachment ? `<a href="uploads/attachments/${log.first_attachment}" ${isImg?'class="table-lightbox"':'target="_blank"'} class="text-slate-400 hover:text-blue-500"><i class="fas fa-paperclip"></i></a>` : '';
                
                const urgencyColor = log.urgency==='ด่วนที่สุด'?'text-red-500 font-bold':(log.urgency==='ด่วน'?'text-amber-500 font-semibold':'text-slate-400');
                const coColor = log.company==='PTA'?'bg-emerald-100 text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-400':(log.company==='PT4'?'bg-red-100 text-red-700 dark:bg-red-900/30 dark:text-red-400':'bg-blue-100 text-blue-700 dark:bg-blue-900/30 dark:text-blue-400');

                // Timeline Logic (Copied from my_tickets.html)
                let currentIdx = 0;
                let subStatus = '';
                let activeColor = 'blue';
                let isCancelled = log.status === 'Cancelled';

                if (log.status === 'Pending') currentIdx = 0;
                else if (['In Progress', 'Waiting for Parts', 'Temporary Fix'].includes(log.status)) {
                    currentIdx = 1;
                    if(log.status === 'Waiting for Parts') { subStatus = 'รออะไหล่'; activeColor = 'orange'; }
                    else if(log.status === 'Temporary Fix') { subStatus = 'แก้ชั่วคราว'; activeColor = 'indigo'; }
                    else { subStatus = 'กำลังซ่อม'; activeColor = 'blue'; }
                }
                else if (log.status === 'Completed') { currentIdx = 2; activeColor = 'emerald'; }

                const steps = [
                    { label: 'รับเรื่อง', icon: 'fa-file-import' },
                    { label: 'ดำเนินการ', icon: 'fa-tools' },
                    { label: 'เสร็จสิ้น', icon: 'fa-check' }
                ];

                let timelineHtml = '';
                if (isCancelled) {
                    timelineHtml = `<div class="w-full min-w-[180px] flex items-center justify-center text-slate-400 font-bold text-xs"><i class="fas fa-ban mr-2 text-red-400"></i> ยกเลิกงานแล้ว</div>`;
                } else {
                    timelineHtml = `<div class="flex items-center w-full min-w-[180px] pb-2 pt-1">
                        ${steps.map((s, i) => {
                            let circle = 'bg-slate-200 text-slate-400 dark:bg-slate-700 dark:text-slate-500';
                            let text = 'text-slate-400 dark:text-slate-500';
                            
                            if (i < currentIdx) {
                                circle = 'bg-emerald-500 text-white';
                                text = 'text-emerald-600 dark:text-emerald-400 font-medium';
                            } else if (i === currentIdx) {
                                if(activeColor === 'blue') { circle = 'bg-blue-500 text-white ring-2 ring-blue-100 dark:ring-blue-900/30'; text = 'text-blue-600 dark:text-blue-400 font-bold'; }
                                else if(activeColor === 'orange') { circle = 'bg-orange-500 text-white ring-2 ring-orange-100 dark:ring-orange-900/30'; text = 'text-orange-500 dark:text-orange-400 font-bold'; }
                                else if(activeColor === 'indigo') { circle = 'bg-indigo-500 text-white ring-2 ring-indigo-100 dark:ring-indigo-900/30'; text = 'text-indigo-600 dark:text-indigo-400 font-bold'; }
                                else if(activeColor === 'emerald') { circle = 'bg-emerald-500 text-white ring-2 ring-emerald-100 dark:ring-emerald-900/30'; text = 'text-emerald-600 dark:text-emerald-400 font-bold'; }
                            }
                            
                            const lineHtml = i > 0 ? `<div class="flex-1 h-0.5 mx-1 rounded ${i <= currentIdx ? 'bg-emerald-500' : 'bg-slate-200 dark:bg-slate-700'}"></div>` : '';
                            
                            return `${lineHtml}
                                <div class="relative flex flex-col items-center group/step">
                                    <div class="w-6 h-6 rounded-full flex items-center justify-center text-[10px] z-10 transition-all ${circle}">
                                        <i class="fas ${s.icon}"></i>
                                    </div>
                                    <div class="absolute top-7 text-[9px] whitespace-nowrap ${text}">
                                        ${s.label}
                                        ${i === 1 && subStatus && i === currentIdx ? `<div class="text-[8px] opacity-80">${subStatus}</div>` : ''}
                                    </div>
                                </div>`;
                        }).join('')}
                    </div>`;
                }

                // Highlight Selected Row
                const activeClass = (log.id === selectedLogId) ? 'bg-blue-100 dark:bg-blue-900/40' : '';

                const duration = formatDuration(log.date, log.completed_date);
                const closedDateStr = log.completed_date ? new Date(log.completed_date).toLocaleDateString('th-TH') : '-';
                const workDuration = formatSecondsToDuration(log.total_work_duration_seconds);

                // Action Buttons
                let actions = `
                    <button onclick="openLogModal('${log.id}')" class="p-1.5 text-slate-400 hover:text-blue-600 transition"><i class="fas fa-edit"></i></button>
                    <button onclick="deleteItem('${log.id}')" class="p-1.5 text-slate-400 hover:text-red-600 transition"><i class="fas fa-trash"></i></button>`;
                
                if(log.status==='Pending') {
                    actions = `<button onclick="startTicket('${log.id}')" class="p-1.5 text-amber-500 hover:bg-amber-50 rounded" title="เริ่มงาน (Start)"><i class="fas fa-play"></i></button>` + 
                              `<button onclick="cancelTicket('${log.id}')" class="p-1.5 text-slate-400 hover:bg-slate-100 rounded" title="ยกเลิก (Cancel)"><i class="fas fa-ban"></i></button>` + actions;
                } else if(['In Progress','Waiting for Parts', 'Temporary Fix'].includes(log.status)) {
                    if(log.status === 'In Progress') actions = `<button onclick="pauseTicket('${log.id}')" class="p-1.5 text-orange-500 hover:bg-orange-50 rounded" title="พักงาน (Pause)"><i class="fas fa-pause"></i></button>` + actions;
                    else actions = `<button onclick="startTicket('${log.id}')" class="p-1.5 text-blue-500 hover:bg-blue-50 rounded" title="ดำเนินการต่อ (Resume)"><i class="fas fa-play-circle"></i></button>` + actions;
                    actions = `<button onclick="finishTicket('${log.id}')" class="p-1.5 text-emerald-500 hover:bg-emerald-50 rounded" title="ปิดงาน (Finish)"><i class="fas fa-check-circle"></i></button>` + 
                              `<button onclick="cancelTicket('${log.id}')" class="p-1.5 text-slate-400 hover:bg-slate-100 rounded" title="ยกเลิก (Cancel)"><i class="fas fa-ban"></i></button>` + actions;
                }

                return `
                <tr id="row-${log.id}" class="group ${activeClass} hover:bg-slate-50 dark:hover:bg-slate-800/50 border-b border-slate-100 dark:border-slate-700/50 transition-colors cursor-pointer" onclick="showFullDetails('${log.id}')">
                    <td class="px-6 py-4 text-center no-print">${attach}</td>
                    <td class="px-6 py-4">
                        <div class="flex flex-col items-start gap-1">
                            <span class="font-mono font-bold text-xs px-2 py-0.5 rounded ${coColor}">${log.id}</span>
                            <span class="text-xs text-slate-400">${new Date(log.date).toLocaleDateString('th-TH')}</span>
                        </div>
                    </td>
                    <td class="px-6 py-4">
                        <div class="font-medium text-slate-700 dark:text-slate-200">${log.requester||'-'}</div>
                        <div class="text-xs text-slate-500"><i class="fas fa-building mr-1"></i>${log.department||'-'}</div>
                        ${(log.asset_id || log.asset) ? `<div class="text-xs text-indigo-500 mt-0.5 cursor-pointer hover:underline" onclick="event.stopPropagation(); showAssetRepairHistory('${log.asset_id || log.asset}')"><i class="fas fa-desktop mr-1"></i>${log.asset_id || log.asset}</div>` : ''}
                    </td>
                    <td class="px-6 py-4">
                        <div class="text-sm text-slate-700 dark:text-slate-300 line-clamp-2">${log.problem||'-'}</div>
                        ${log.solution ? `<div class="text-xs text-emerald-600 dark:text-emerald-400 mt-1 line-clamp-1"><i class="fas fa-wrench mr-1"></i>${log.solution}</div>` : ''}
                        <div class="text-[10px] mt-1 ${urgencyColor}"><i class="fas fa-exclamation-circle mr-1"></i>${log.urgency}</div>
                    </td>
                    <td class="px-6 py-4 text-sm text-slate-600 dark:text-slate-400 align-top">${log.servicedBy||'-'}</td>
                    <td class="px-6 py-2 align-middle">${timelineHtml}</td>
                    <td class="px-6 py-4 text-xs align-top">
                        <div class="text-slate-600 dark:text-slate-300">${closedDateStr}</div>
                        ${log.completed_date ? `<div class="text-indigo-500 font-medium" title="Total Ticket Time">${duration}</div>` : ''}
                        ${workDuration !== '-' ? `<div class="text-amber-600 font-bold" title="Actual Work Time"><i class="fas fa-stopwatch mr-1"></i>${workDuration}</div>` : ''}
                    </td>
                    <td class="px-6 py-4 text-right no-print" onclick="event.stopPropagation()">
                        <div class="flex justify-end gap-1 opacity-0 group-hover:opacity-100 transition-opacity admin-action-btn">${actions}</div>
                    </td>
                </tr>`;
            }).join('');
            
            if(lightbox) lightbox.refresh(); else lightbox = new SimpleLightbox('.table-lightbox', { /* options */ });
            if(['admin', 'staff'].includes(userRole)) document.querySelectorAll('.admin-action-btn').forEach(b => b.style.opacity = '1');
        }

        async function showFullDetails(logId) {
            // Highlight Row Logic
            selectedLogId = logId;
            document.querySelectorAll('#table-body tr').forEach(tr => tr.classList.remove('bg-blue-100', 'dark:bg-blue-900/40'));
            const row = document.getElementById(`row-${logId}`);
            if(row) row.classList.add('bg-blue-100', 'dark:bg-blue-900/40');

            const log = allLogs.find(l => l && l.id === logId); 
            if (!log) return;
            
            let imagesHtml = '';
            try {
                const res = await fetch(`api.php?action=get&file=it_log_attachments&log_id=${logId}`);
                const files = await res.json();
                if (Array.isArray(files) && files.length > 0) {
                    const imgs = files.filter(f => /\.(jpg|jpeg|png|gif|webp)$/i.test(f.stored_filename));
                    if (imgs.length > 0) {
                        imagesHtml = `
                        <div class="mt-4 border-t border-slate-100 dark:border-slate-700 pt-3">
                            <h4 class="font-bold text-slate-700 dark:text-slate-200 mb-2 text-xs uppercase"><i class="fas fa-images text-blue-500 mr-1"></i> รูปภาพประกอบ</h4>
                            <div class="popup-gallery grid grid-cols-4 gap-2">
                                ${imgs.map(f => `<a href="uploads/attachments/${f.stored_filename}" class="block aspect-square rounded-lg overflow-hidden border border-slate-200 dark:border-slate-600 hover:opacity-80 transition bg-slate-100"><img src="uploads/attachments/${f.stored_filename}" class="w-full h-full object-cover" alt="${f.original_filename}"></a>`).join('')}
                            </div>
                        </div>`;
                    }
                }
            } catch(e) { console.error(e); }

            const txt = (t) => t || '-';
            
            const content = `
                <div class="text-left font-sans text-sm space-y-4">
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-4 gap-y-2 bg-slate-50 dark:bg-slate-700/30 p-3 rounded-lg border border-slate-100 dark:border-slate-700">
                        <div><span class="text-slate-500 dark:text-slate-400">วันที่:</span> <span class="font-medium dark:text-slate-200">${new Date(log.date).toLocaleDateString('th-TH')}</span></div>
                        <div><span class="text-slate-500 dark:text-slate-400">สถานะ:</span> <span class="${getStatusClass(log.status)} px-2 py-0.5 rounded text-xs font-bold">${log.status}</span></div>
                        <div><span class="text-slate-500 dark:text-slate-400">ผู้แจ้ง:</span> <span class="font-medium dark:text-slate-200">${txt(log.requester)}</span></div>
                        <div><span class="text-slate-500 dark:text-slate-400">แผนก:</span> <span class="font-medium dark:text-slate-200">${txt(log.department)}</span></div>
                        <div><span class="text-slate-500 dark:text-slate-400">ประเภท:</span> <span class="font-medium dark:text-slate-200">${txt(log.type)}</span></div>
                        <div><span class="text-slate-500 dark:text-slate-400">ความเร่งด่วน:</span> <span class="font-medium ${log.urgency==='ด่วนที่สุด'?'text-red-500':(log.urgency==='ด่วน'?'text-amber-500':'dark:text-slate-200')}">${txt(log.urgency)}</span></div>
                        ${(log.asset_id || log.asset) ? `<div class="col-span-1 sm:col-span-2"><span class="text-slate-500 dark:text-slate-400">Asset:</span> <span class="font-mono text-indigo-500">${log.asset_id || log.asset}</span></div>` : ''}
                        ${log.appointment_date ? `<div class="col-span-1 sm:col-span-2"><span class="text-slate-500 dark:text-slate-400">นัดหมาย:</span> <span class="font-medium text-indigo-600 dark:text-indigo-400">${new Date(log.appointment_date).toLocaleString('th-TH', { dateStyle: 'medium', timeStyle: 'short' })}</span></div>` : ''}
                        ${log.servicedBy ? `<div class="col-span-1 sm:col-span-2 border-t border-slate-200 dark:border-slate-600 pt-2 mt-1"><span class="text-slate-500 dark:text-slate-400">ผู้รับผิดชอบ:</span> <span class="font-medium dark:text-slate-200">${log.servicedBy}</span></div>` : ''}
                    </div>

                    <div>
                        <h4 class="font-bold text-slate-700 dark:text-slate-200 mb-1"><i class="fas fa-circle-exclamation text-red-400 mr-1"></i> ปัญหา / อาการ</h4>
                        <div class="bg-white dark:bg-slate-800 p-3 rounded border border-slate-200 dark:border-slate-600 text-slate-600 dark:text-slate-300 whitespace-pre-wrap">${txt(log.problem)}</div>
                    </div>

                    ${log.solution ? `
                    <div>
                        <h4 class="font-bold text-slate-700 dark:text-slate-200 mb-1"><i class="fas fa-check-circle text-emerald-500 mr-1"></i> วิธีแก้ไข</h4>
                        <div class="bg-emerald-50 dark:bg-emerald-900/20 p-3 rounded border border-emerald-100 dark:border-emerald-800 text-emerald-800 dark:text-emerald-300 whitespace-pre-wrap">${log.solution}</div>
                    </div>` : ''}

                    ${imagesHtml}
                </div>`;
            
            Swal.fire({ 
                title: `<span class="text-xl font-bold text-slate-800 dark:text-white">Case ID: ${log.id}</span>`, 
                html: content, 
                width: '600px',
                showConfirmButton: true,
                confirmButtonText: 'ปิด',
                confirmButtonColor: '#3b82f6',
                showCloseButton: true,
                showDenyButton: true,
                denyButtonText: '<i class="fas fa-print"></i> พิมพ์ใบงาน',
                denyButtonColor: '#64748b',
                preDeny: () => { printSingleTicket(log); return false; },
                customClass: { popup: 'dark:bg-slate-800 dark:border dark:border-slate-700' },
                didOpen: () => new SimpleLightbox('.popup-gallery a', { uniqueImages: false })
            });
        }

        function printSingleTicket(log) {
            const pc = document.querySelector('.print-container');
            const txt = (t) => t || '-';
            // สร้าง URL สำหรับเปิดหน้านี้พร้อมระบุ Ticket ID
            const ticketUrl = `${window.location.origin}${window.location.pathname}?ticket_id=${log.id}`;
            
            // Inject Portrait Style for Ticket (บังคับแนวตั้งสำหรับใบงาน)
            const style = document.createElement('style');
            style.id = 'print-orientation';
            style.innerHTML = '@page { size: A4 portrait; margin: 1cm; }';
            document.head.appendChild(style);

            // TISAX/ISO Compliance: Add footer with document control and confidentiality
            const footerHtml = `
                <footer class="mt-8 pt-4 border-t border-slate-200 text-[9px] text-slate-400 flex justify-between">
                    <div>FM-IT-001-Rev.01 (01/01/2024)</div>
                    <div>Printed by: ${currentUserName || 'N/A'} on ${new Date().toLocaleString('th-TH')}</div>
                    <div>CONFIDENTIAL: Internal Use Only</div>
                </footer>`;

            pc.innerHTML = `
                <div class="font-sans text-slate-800 w-full max-w-[210mm] mx-auto border border-slate-300 p-8 bg-white min-h-[270mm]">
                    <div class="flex justify-between items-start border-b-2 border-slate-800 pb-4 mb-6">
                        <div>
                            <h1 class="text-3xl font-bold uppercase tracking-wider text-slate-800">JOB TICKET</h1>
                            <p class="text-sm text-slate-500 font-medium mb-2">IT Service Department</p>
                            <div id="ticket-qrcode"></div>
                        </div>
                        <div class="text-right">
