        function updateStatistics() {
            const counts = { 'Pending':0, 'In Progress':0, 'Waiting for Parts':0, 'Temporary Fix':0, 'Completed':0 };
            allLogs.forEach(l => { if(l && counts[l.status] !== undefined) counts[l.status]++; });
            gid('totalTickets').textContent = allLogs.length;
            
            if(gid('pendingTickets')) gid('pendingTickets').textContent = counts['Pending'];
            if(gid('progressTickets')) gid('progressTickets').textContent = counts['In Progress'];
            if(gid('waitingTickets')) gid('waitingTickets').textContent = counts['Waiting for Parts'];
            if(gid('tempFixTickets')) gid('tempFixTickets').textContent = counts['Temporary Fix'];
            if(gid('completedTickets')) gid('completedTickets').textContent = counts['Completed'];
            
            if(!gid('chart-section').classList.contains('hidden')) {
                renderChart(counts);
            }
        }

        function toggleChart() {
            const sec = gid('chart-section');
            sec.classList.toggle('hidden');
            if(!sec.classList.contains('hidden')) {
                updateStatistics();
            }
        }

        function renderChart(counts) {
            const ctx = gid('statusPieChart').getContext('2d');
            
            if(statusChartInstance) statusChartInstance.destroy();

            const labels = ['Pending', 'In Progress', 'Waiting for Parts', 'Temporary Fix', 'Completed'];
            const data = labels.map(l => counts[l] || 0);
            const colors = ['#3b82f6', '#f59e0b', '#ef4444', '#6366f1', '#10b981'];

            statusChartInstance = new Chart(ctx, {
                type: 'pie',
                data: {
                    labels: labels,
                    datasets: [{
                        data: data,
                        backgroundColor: colors,
                        borderWidth: 1
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { position: 'right', labels: { color: document.documentElement.classList.contains('dark') ? '#cbd5e1' : '#475569' } } }
                }
            });
        }

        // --- 4. Form & Logic ---
        async function openLogModal(logId = null) {
            currentEditId = logId;
            gid('log-form').reset();
            gid('attachment-list').innerHTML = '';
            gid('modal-title').textContent = logId ? `แก้ไขใบงาน ${logId}` : 'เพิ่มใบงานใหม่';
            
            document.querySelector('input[name="requester-mode"][value="auto"]').checked = true;
            toggleRequesterMode();
            populateAllRequestersDropdown();
            gid('repair-cost-wrapper').classList.toggle('hidden', !['admin', 'staff'].includes(userRole));

            if (logId) {
                const log = allLogs.find(l => l.id === logId);
                if(log) {
                    gid('form-date').value = log.date;
                    gid('form-problem').value = log.problem;
                    gid('form-solution').value = log.solution;
                    gid('form-status').value = log.status;
                    gid('form-type').value = log.type;
                    gid('form-urgency').value = log.urgency;
                    gid('form-asset').value = log.asset_id || log.asset || '';
                    gid('form-appointment_date').value = log.appointment_date || '';
                    gid('form-repair_cost').value = log.repair_cost || '';
                    
                    // Serviced By ID
                    if(log.servicedById) gid('form-servicedBy').value = log.servicedById;
                    else {
                        const tech = allEmployees.find(e => e.name === log.servicedBy);
                        if(tech) gid('form-servicedBy').value = tech.id;
                    }

                    // Requester Mode Logic
                    let reqFound = false;
                    if(log.requester_id) {
                        const emp = allEmployees.find(e => e.id === log.requester_id);
                        if(emp) { gid('form-requester-select').value = emp.name; reqFound = true; }
                    }
                    if(!reqFound) {
                        document.querySelector('input[name="requester-mode"][value="manual"]').checked = true;
                        toggleRequesterMode();
                        gid('form-company').value = log.company;
                        populateManualDepartmentDropdown();
                        gid('form-department').value = log.department;
                        // extract job name
                        const m = log.requester?.match(/\((.*?)\)/);
                        if(m) gid('form-job-name-manual').value = m[1];
                    }
                    displayAttachments(logId);
                }
            } else {
                gid('form-date').value = new Date().toISOString().split('T')[0];
                gid('form-status').value = 'Pending';
                gid('form-urgency').value = 'ปกติ';
                // Auto-select current user
                const uid = sessionStorage.getItem('user_id');
                if(uid) {
                    if(userRole !== 'user') gid('form-servicedBy').value = uid;
                    const emp = allEmployees.find(e => e.id === uid);
                    if(emp) gid('form-requester-select').value = emp.name;
                }
            }
            gid('log-modal').classList.remove('hidden');
        }

        // --- 5. Handlers ---
        async function handleLogSubmit(e) {
            e.preventDefault();
            const btn = e.target.querySelector('button[type="submit"]');
            btn.disabled = true; btn.innerHTML = 'Saving...';

            const isMan = document.querySelector('input[name="requester-mode"]:checked').value === 'manual';
            let reqName, co, dept, empId = null;

            if(isMan) {
                co = gid('form-company').value;
                dept = gid('form-department').value;
                const job = gid('form-job-name-manual').value.trim();
                reqName = job ? `${dept} (${job})` : dept;
                if(!co || !dept) { alert('Missing Info'); btn.disabled=false; return; }
            } else {
                const opt = gid('form-requester-select').selectedOptions[0];
                if(!opt || !opt.value) { alert('Select Requester'); btn.disabled=false; return; }
                reqName = opt.value;
                co = opt.dataset.company;
                dept = opt.dataset.department;
                empId = opt.dataset.id;
            }

            const data = {
                date: gid('form-date').value,
                company: co, department: dept, requester: reqName,
                servicedBy: gid('form-servicedBy').selectedOptions[0]?.text || '',
                asset_id: gid('form-asset').value,
                problem: gid('form-problem').value,
                solution: gid('form-solution').value,
                status: gid('form-status').value,
                type: gid('form-type').value,
                urgency: gid('form-urgency').value,
                repair_cost: gid('form-repair_cost').value || null,
                appointment_date: gid('form-appointment_date').value || null
            };
            if(currentEditId) data.id = currentEditId;

            const fd = new FormData();
            fd.append('action', currentEditId ? 'update_item' : 'add_item');
            fd.append('key', 'it_logs');
            fd.append('data', JSON.stringify(data));
            fd.append('servicedById', gid('form-servicedBy').value);
            if(empId) fd.append('requester_id', empId);

            try {
                const res = await (await fetch('api.php', { method:'POST', body:fd })).json();
                if(res.status!=='success') throw new Error(res.message);
                
                await uploadFiles(currentEditId || res.new_id, 'form-attachments');
                await loadInitialData();
                closeModal();
                Swal.fire({ icon:'success', title:'Saved', toast:true, position:'top-end', showConfirmButton:false, timer:1500 });
            } catch(err) {
                Swal.fire('Error', err.message, 'error');
            } finally {
                btn.disabled = false; btn.innerHTML = 'บันทึกข้อมูล';
            }
        }

        async function uploadFiles(logId, inputId) {
            const files = gid(inputId).files;
            for(const f of files) {
                const fd = new FormData();
                fd.append('action', 'upload_attachment');
                fd.append('log_id', logId);
                fd.append('attachmentFile', f);
                await fetch('api.php', { method:'POST', body:fd });
            }
        }

