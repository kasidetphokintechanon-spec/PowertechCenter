# --- Google Gemini (free tier via Google AI Studio) ---
# Get key: https://aistudio.google.com/app/apikey
# Not Cursor Pro. Not necessarily a paid Gemini Advanced subscription.
# Rate limits apply on the free tier; use gemini-3-flash-preview for cron.
# GEMINI_API_KEY=
# GOOGLE_API_KEY=

# --- Other LLM providers (pick one if not using Gemini) ---
# OPENAI_API_KEY=sk-...
# OPENROUTER_API_KEY=sk-or-...
# ANTHROPIC_API_KEY=sk-ant-...

# --- Optional tool APIs ---
# EXA_API_KEY=
# TAVILY_API_KEY=

# --- Hermes runtime ---
# HERMES_CRON_MAX_PARALLEL=2
# HERMES_ACCEPT_HOOKS=1
TZ=Asia/Bangkok
